{
  "manifest_version": 3,
  "name": "Application Autofill",
  "version": "2.0",
  "description": "Fills the job application in this tab from your dictionary; the AI writes answers only when you click. Needs python3 autofill.py --serve.",
  "action": {"default_popup": "popup.html", "default_title": "Fill this application (Alt+Shift+F)"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+F"}}},
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {"gecko": {"id": "application-autofill@batchautofiller", "strict_min_version": "128.0",
                                          "data_collection_permissions": {"required": ["none"]}}}
}
